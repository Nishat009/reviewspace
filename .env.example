# Postgres connection used by Prisma (Supabase: use the pooled connection string).
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB"
# Connection pool size. Use 1 with `pnpm db:dev` (prisma dev serves one connection at a time).
DATABASE_POOL_MAX="10"
# Only needed for `prisma migrate dev`.
SHADOW_DATABASE_URL=""

# Public origin of the app; used to build links in emails.
APP_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Supabase Storage. The service-role key is server-only; never expose it to the browser.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="reviewspace-private"

# Resend. When empty in development, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="ReviewSpace <onboarding@resend.dev>"

# Throwaway database for `pnpm test:db` (migrations applied on every run).
TEST_DATABASE_URL=""

# Storage driver: "supabase" (default when SUPABASE_* are set) or "local"
# (files under LOCAL_STORAGE_DIR, served through signed /api/storage URLs; dev only).
STORAGE_DRIVER=""
LOCAL_STORAGE_DIR=".storage"

# Realtime fan-out: "memory" (single server, default) or "postgres" (LISTEN/NOTIFY,
# needed when running more than one instance). LISTEN needs a direct, non-pooled
# connection; set REALTIME_DATABASE_URL if DATABASE_URL goes through a pooler.
REALTIME_DRIVER="memory"
REALTIME_DATABASE_URL=""

# Bearer secret for GET /api/cron/cleanup (removes abandoned uploads).
CRON_SECRET=""

# Optional "Continue with Google". Leave empty to hide the button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
